{
  "name": "gatex",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .tmp-tests/tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "gatec:live": "tsc -p tsconfig.test.json && node .tmp-tests/scripts/gate-c-live.js",
    "gated:preflight": "tsc -p tsconfig.test.json && node .tmp-tests/scripts/gate-d-preflight.js",
    "gated2:preflight": "tsc -p tsconfig.test.json && node .tmp-tests/scripts/gate-d2-preflight.js",
    "gatee0:live": "tsc -p tsconfig.test.json && node .tmp-tests/scripts/gate-e0-live.js",
    "gatee:final:live": "tsc -p tsconfig.test.json && node .tmp-tests/scripts/gate-e-final-live.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.7.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.9"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
